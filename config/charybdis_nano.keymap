#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/runtime_input_processor.h>
#include <dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-input-processor.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define NUMBER  1
#define SYMBOL  2
#define MOUSE  3

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <170>;
};

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "L_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp LCLK>, <&mkp LCLK>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "M_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp MCLK>, <&mkp MCLK>;
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "R_CLK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mkp RCLK>, <&mkp RCLK>;
        };

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPC_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        shft_caps: shft_caps {
            compatible = "zmk,behavior-tap-dance";
            label = "SHFT_CAPS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;

            tapping-term-ms = <120>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_hotkeys {
            bindings = <&mo 3>;
            key-positions = <62 63>;
        };
    };

    macros {
        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
            label = "BT_0";
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
            label = "BT_1";
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
            label = "BT_2";
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
            label = "BT_3";
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4>;
            label = "BT_4";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            label = "BASE";
            bindings = <
&kp GRAVE  &kp N1    &kp N2         &kp N3     &kp N4        &kp N5      &kp N6  &kp N7               &kp N8            &kp N9    &kp N0  &kp BSLH
&kp TAB    &kp SQT   &kp COMMA      &kp DOT    &kp P         &kp Y       &kp F   &kp G                &kp C             &kp R     &kp L   &bspc_del
&kp ESC    &kp A     &kp O          &kp E      &kp U         &kp I       &kp D   &kp H                &kp T             &kp N     &kp S   &kp RET
&kp EQUAL  &kp FSLH  &kp Q          &kp J      &kp K         &kp X       &kp B   &kp M                &kp W             &kp V     &kp Z   &kp MINUS
                     &kp SEMICOLON  &kp COLON  &kp SPACE     &shft_caps  &none   &lt 1 K_APPLICATION  &kp LEFT_BRACKET  &kp RBKT
                     &kp LEFT_ALT   &tog 5     &kp LEFT_GUI  &kp LCTRL   &none   &none                &tog 2            &mo 4
            >;
        };

        arrows {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans  &trans     &trans
                &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans
                &trans  &none   &trans  &trans  &trans  &trans    &trans    &trans
            >;

            label = "ARROWS";
        };

        gaming {
            bindings = <
&kp N5  &kp ESC    &kp N1  &kp N2  &kp N3     &kp N4  &trans     &trans        &trans          &trans    &trans    &trans
&kp N6  &kp TAB    &kp Q   &kp W   &kp E      &kp R   &trans     &msc SCRL_UP  &msc SCRL_DOWN  &trans    &trans    &trans
&kp N7  &kp LSHFT  &kp A   &kp S   &kp D      &kp F   &mkp MCLK  &mkp LCLK     &mkp RCLK       &mkp MB4  &mkp MB5  &mo 6
&kp N8  &kp LCTRL  &kp Z   &kp X   &kp C      &kp V   &trans     &trans        &mo 6           &trans    &trans    &trans
                   &kp N9  &kp N0  &kp SPACE  &kp T   &trans     &trans        &trans          &trans
                   &kp L   &kp J   &kp G      &kp M   &trans     &trans        &tog 2          &trans
            >;

            label = "GAMING";
        };

        hotkeys {
            label = "HOTKEYS";
            bindings = <
&none        &none  &none         &none  &none  &none  &none  &none       &none       &none           &none  &none
&none        &none  &none         &none  &none  &none  &none  &none       &none       &none           &none  &none
&bootloader  &none  &none         &none  &none  &none  &none  &none       &none       &none           &none  &bootloader
&sys_reset   &none  &none         &none  &none  &none  &none  &none       &none       &none           &none  &sys_reset
                    &none         &none  &bt_0  &bt_1  &none  &bt BT_CLR  &none       &none
                    &out OUT_USB  &bt_3  &bt_4  &bt_2  &none  &none       &bl BL_TOG  &studio_unlock
            >;
        };

        fkeys {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F10  &kp F11  &kp F12  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F7   &kp F8   &kp F9   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F4   &kp F5   &kp F6   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp F1   &kp F2   &kp F3   &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
                &trans  &trans  &trans  &trans  &trans  &trans   &trans   &trans
            >;

            label = "FKEYS";
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans          &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &msc SCRL_UP  &msc SCRL_DOWN  &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB3  &mkp MB1      &mkp MB2        &mkp MB4  &mkp MB5  &mo 6
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &mo 6         &trans          &trans    &trans    &trans
                &trans  &trans  &trans  &trans  &trans    &trans        &trans          &trans
                &trans  &trans  &trans  &trans  &trans    &trans        &trans          &trans
            >;

            label = "MOUSE";
        };

        scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "SCROLL";
        };
    };
};

&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <3>;
    temp-layer-activation-delay-ms = <200>;
    temp-layer-deactivation-delay-ms = <400>;
};

&scroll_runtime_input_processor {
    active-layers = <BIT(1)>;
    x-codes = <INPUT_REL_X>;
    y-codes = <INPUT_REL_Y>;
    xy-to-scroll-enabled;
    axis-snap-threshold = <100>;
};
